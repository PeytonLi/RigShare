# Copy to .env and fill. Never commit .env.

# --- Linq ---
LINQ_API_KEY=
LINQ_FROM_NUMBER=+1
LINQ_WEBHOOK_SECRET=
RENDER_WORKFLOW_SLUG=

# --- Stripe (same account Linq Connect uses) ---
# test vs live MUST match how Linq is charging
STRIPE_SECRET_KEY=
STRIPE_MODE=test

# --- Pioneer ---
# Account key: decoder inference + /felix/training-jobs (note: no /v1 prefix).
PIONEER_API_KEY=
PIONEER_DECODER_MODEL_ID=claude-haiku-4-5
# Encoder models each carry their own key and are absent from GET /v1/models.
# They take a `schema` (entities / classifications) instead of a prompt.
PIONEER_NER_BASE_MODEL=fastino/gliner2-large-v1
PIONEER_NER_MODEL_ID=
PIONEER_NER_API_KEY=
PIONEER_GUARD_API_KEY=
PIONEER_PII_API_KEY=

# --- Band ---
BAND_HUMAN_API_KEY=
BAND_MATCHER_AGENT_ID=
BAND_MATCHER_API_KEY=
BAND_CONDITION_AGENT_ID=
BAND_CONDITION_API_KEY=
BAND_CLERK_AGENT_ID=
BAND_CLERK_API_KEY=

# --- Superserve ---
SUPERSERVE_API_KEY=
SUPERSERVE_TEMPLATE_ID=
# Pixels differing out of 512x512 before a return is BLOCKED. Retune on real photos.
SUPERSERVE_BLOCK_METRIC=150000

# --- Terac ---
TERAC_API_KEY=
TERAC_PROJECT_ID=

# --- Render (used by workflows SDK at runtime on Render) ---
# RENDER_API_KEY=   # only if we trigger tasks from local

# --- App ---
DATABASE_URL=postgresql://localhost:5432/rigshare
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
INTERNAL_SETTLE_SECRET=change-me
REQUIRE_CLERK_SETTLE=false
LENDER_PHONE=+14159909839
TEST_BORROWER_PHONE=+19254747652
# SKU prices live in app/skus.py and app/money.py, not here -- a stale env value
# must not change hallway quotes. This flips new listings to the $8/$2/$1 demo SKU.
DEMO_MODE=false
