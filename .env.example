# Copy to .env and fill. Never commit .env.

# --- Linq ---
LINQ_API_KEY=
LINQ_FROM_NUMBER=+1
LINQ_WEBHOOK_SECRET=

# --- Stripe (same account Linq Connect uses) ---
# test vs live MUST match how Linq is charging
STRIPE_SECRET_KEY=
STRIPE_MODE=test

# --- Pioneer ---
PIONEER_API_KEY=
PIONEER_NER_MODEL_ID=
PIONEER_DECODER_MODEL_ID=claude-haiku-5

# --- Band ---
BAND_HUMAN_API_KEY=
BAND_MATCHER_AGENT_ID=
BAND_MATCHER_API_KEY=
BAND_CONDITION_AGENT_ID=
BAND_CONDITION_API_KEY=
BAND_CLERK_AGENT_ID=
BAND_CLERK_API_KEY=

# --- Superserve ---
SUPERSERVE_API_KEY=
SUPERSERVE_TEMPLATE_ID=

# --- Terac ---
TERAC_API_KEY=
TERAC_PROJECT_ID=

# --- Render (used by workflows SDK at runtime on Render) ---
# RENDER_API_KEY=   # only if we trigger tasks from local

# --- App ---
DATABASE_URL=postgresql://localhost:5432/rigshare
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
INTERNAL_SETTLE_SECRET=change-me
LENDER_PHONE=+14159909839
TEST_BORROWER_PHONE=+17034051525
DEFAULT_DEPOSIT_CENTS=2500
DEFAULT_RENTAL_CENTS=500
DEFAULT_PLATFORM_FEE_CENTS=200
DEMO_DEPOSIT_CENTS=800
DEMO_RENTAL_CENTS=200
